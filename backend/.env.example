PORT=4000
NODE_ENV=development

# Redis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=

# SMS (Fast2SMS) — unchanged in Phase 3
FAST2SMS_API_KEY=
FAST2SMS_ENTITY_ID=
FAST2SMS_DEFAULT_SENDER_ID=

# ---------------------------------------------------------------------------
# Email providers (Phase 3) — EMAIL only (SMS unchanged)
# ---------------------------------------------------------------------------
# Order controls selection + safe failover (REJECTED / TEMPORARY_FAILURE).
# UNKNOWN never fails over (duplicate delivery risk).
EMAIL_PROVIDER_ORDER=brevo,resend,sendgrid
EMAIL_FAILOVER_ON_TEMPORARY_FAILURE=true
EMAIL_PROVIDER_TIMEOUT_MS=15000

# Shared fallback from-address used when a provider-specific FROM is unset
EMAIL_FROM=

# Brevo (primary candidate)
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ELVA Notify

# Resend (secondary candidate)
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# SendGrid (retained; auto-enabled when key+EMAIL_FROM exist unless SENDGRID_ENABLED=false)
SENDGRID_ENABLED=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# ---------------------------------------------------------------------------
# Phase 4 — Immediate ops alerts on FINAL delivery failure (observer only)
# ---------------------------------------------------------------------------
# Alerts EMAIL final FAILED and SMS final failure. Never alerts on UNKNOWN.
# Does not change delivery behavior. Disable safely with NOTIFY_FAILURE_ALERT_ENABLED=false.
NOTIFY_FAILURE_ALERT_ENABLED=true
NOTIFY_FAILURE_ALERT_EMAIL=arunpn866@gmail.com

# Daily operational transaction report (previous calendar day)
NOTIFY_DAILY_REPORT_ENABLED=true
NOTIFY_REPORT_TIMEZONE=Asia/Kolkata
NOTIFY_DAILY_REPORT_HOUR=8
NOTIFY_DAILY_REPORT_MINUTE=0

# Integrations onboarding
ADMIN_NOTIFY_EMAIL=ops@example.com
# Receives credential-renewal ops notifications (never includes the new API key)
CREDENTIAL_RENEWAL_ADMIN_EMAIL=arun.pn@elvatech.in
OPS_ADMIN_TOKEN=change-me-in-production
# Public frontend URL for onboarding emails (status links, docs links)
# Development:
PLATFORM_PUBLIC_URL=http://localhost:3000
# Production:
# PLATFORM_PUBLIC_URL=https://notify.elvatech.in
# appId key used in approval emails (defaults to ELVA_NOTIFY, else first APP_CREDENTIALS_JSON entry)
# INTEGRATION_APP_ID=ELVA_NOTIFY

# OTP DLT — global master switch (default false; per-app dltEnabled in otp-mappings.json)
OTP_DLT_ENABLED=false

# Authentication — shared platform appId → apiKey (AUTHORITATIVE in Phase 1)
# Existing clients continue using these credentials unchanged.
APP_CREDENTIALS_JSON={"ELVA_NOTIFY":"shared-platform-api-key"}

# ---------------------------------------------------------------------------
# MongoDB — Phase 1 foundation (optional at runtime; required for migration)
# ---------------------------------------------------------------------------
# MongoDB is introduced as a persistent foundation. With Phase 1 defaults below,
# existing auth and brand reads continue to use APP_CREDENTIALS_JSON + JSON files.
# MongoDB being unavailable does NOT break existing notification APIs.
#
# Prefer mongodb:// host list if mongodb+srv:// fails with querySrv ECONNREFUSED
# (common on some Windows/ISP DNS setups). Atlas → Connect → Drivers → copy the
# standard connection string, or convert srv to explicit shard hosts.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=elva_notify
# MONGODB_REQUIRED=true
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=1
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Phase 2 source flags
# BRAND_SOURCE=json      → brand-registry.json remains runtime source for existing brands
# CREDENTIAL_SOURCE=hybrid → Phase 2 Mongo app credentials + legacy APP_CREDENTIALS_JSON
# Do NOT set CREDENTIAL_SOURCE=mongodb until all clients use Mongo credentials.
BRAND_SOURCE=json
CREDENTIAL_SOURCE=hybrid

# Secret hashing peppers (used when migrating credential hashes / audit hashes)
API_SECRET_PEPPER=change-me-in-production
RECIPIENT_HASH_PEPPER=change-me-in-production
